        <mxCell id="28" value="STAGE 1  PATTERN" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;spacing=4;" vertex="1" parent="1">
