          <mxGeometry x="330" y="1316" width="200" height="66" as="geometry" />
        </mxCell>
        <mxCell id="24" value="Stripe webhook → payment saved,&lt;br&gt;payment_status = Paid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=12;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="310" y="1432" width="240" height="66" as="geometry" />
        </mxCell>
        <mxCell id="25" value="Retailer pays by bank transfer&lt;br&gt;(bank details on Account page)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="1316" width="230" height="66" as="geometry" />
        </mxCell>
        <mxCell id="26" value="Admin records / edits payment&lt;br&gt;(Order List → payment update)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="1432" width="230" height="66" as="geometry" />
        </mxCell>
        <mxCell id="27" value="PAYMENT: Unpaid → Partial → Paid&lt;br&gt;(Dashboard shows bill / paid / balance)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;spacing=4;" vertex="1" parent="1">
