        </mxCell>
        <mxCell id="36" value="Production worker scans the piece barcode on&lt;br&gt;the scanner page; their login is tied to one stage&lt;br&gt;(duplicate scans are blocked)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;spacing=4;" vertex="1" parent="1">
