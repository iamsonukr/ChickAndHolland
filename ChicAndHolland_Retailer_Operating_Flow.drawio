  <diagram id="p1" name="Order &amp; status lifecycle">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="11" value="Retailer wants garments" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="345" y="40" width="190" height="66" as="geometry" />
        </mxCell>
        <mxCell id="12" value="Retailer opens Collections / Inventory / Sample Order,&lt;br&gt;adds items to Cart (or picks stock / fills sample form)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="300" y="156" width="280" height="72" as="geometry" />
        </mxCell>
        <mxCell id="13" value="Retailer clicks &#39;Place Order&#39;&lt;br&gt;(quantities validated, stock checked)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="315" y="278" width="250" height="66" as="geometry" />
        </mxCell>
        <mxCell id="14" value="STATUS: PENDING&lt;br&gt;(Pending Orders page, yellow badge)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="325" y="394" width="230" height="56" as="geometry" />
        </mxCell>
        <mxCell id="15" value="Admin opens Order Request → tab Fresh / Sample / Stock&lt;br&gt;(badge shows count of new requests)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="295" y="500" width="290" height="72" as="geometry" />
        </mxCell>
        <mxCell id="16" value="Admin decision?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="340" y="622" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="17" value="Admin REJECTS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="487.5" y="800" width="200" height="66" as="geometry" />
        </mxCell>
        <mxCell id="18" value="STATUS: REJECTED&lt;br&gt;(Rejected Orders page, red badge)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="472.5" y="930" width="230" height="56" as="geometry" />
        </mxCell>
        <mxCell id="19" value="Admin ACCEPTS: fills PO no., prices, customization,&lt;br&gt;advance, shipping, invoice / estimate, uploads design,&lt;br&gt;sends manufacturer mail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="142.5" y="791" width="300" height="84" as="geometry" />
        </mxCell>
        <mxCell id="20" value="System creates order + one barcode per piece&lt;br&gt;(stock orders: stock qty reduced)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=12;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="152.5" y="925" width="280" height="66" as="geometry" />
        </mxCell>
        <mxCell id="21" value="STATUS: APPROVED / ACCEPTED&lt;br&gt;(My Orders → Accepted tab)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="177.5" y="1041" width="230" height="56" as="geometry" />
        </mxCell>
        <mxCell id="22" value="How does retailer pay?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="192.5" y="1147" width="200" height="100" as="geometry" />
        </mxCell>
