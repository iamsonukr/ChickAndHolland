          <mxGeometry x="345" y="2140" width="190" height="56" as="geometry" />
        </mxCell>
        <mxCell id="33" value="STAGE 6  STITCHING" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;spacing=4;" vertex="1" parent="1">
