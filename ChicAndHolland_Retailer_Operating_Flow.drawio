        </mxCell>
        <mxCell id="39" value="Admin marks READY TO DELIVERY&lt;br&gt;(Global QR Scan / admin only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=4;" vertex="1" parent="1">
