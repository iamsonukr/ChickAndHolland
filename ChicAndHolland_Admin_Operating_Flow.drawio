ometry></mxCell><mxCell id="59" value="" style="edgeStyle=none;rounded=1;curved=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.000;entryY=0.392;entryDx=0;entryDy=0;" edge="1" parent="1" source="29" target="31"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="515.0" y="1673.0"/><mxPoint x="515.0" y="1698.4"/><mxPoint x="1193.8" y="1698.4"/></Array></mxGeometry></mxCell><mxCell id="60" value="" style="edgeStyle=none;rounded=1;curved=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1.000;exitDx=0;exitDy=0;entryX=0.000;entryY=0.424;entryDx=0;entryDy=0;" edge="1" parent="1" source="30" target="31"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="185.0" y="1673.0"/><mxPoint x="185.0" y="1699.5"/><mxPoint x="1193.8" y="1699.5"/></Array></mxGeometry></mxCell><mxCell id="61" value="&lt;b style=&quot;font-size:22px&quot;&gt;Admin | How an admin / staff user operates the panel day to day&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#555555&quot;&gt;What to check and do, in order (menu items depend on the role's permissions)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="-40" width="1300" height="56" as="geometry"/></mxCell><mxCell id="62" value="Legend" style="text;html=1;fontStyle=1;fontSize=14;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1794" width="100" height="24" as="geometry"/></mxCell><mxCell id="63" value="Retailer (web panel)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1824" width="160" height="46" as="geometry"/></mxCell><mxCell id="64" value="Admin (admin panel)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="240" y="1824" width="160" height="46" as="geometry"/></mxCell><mxCell id="65" value="Production worker (scanner)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="1824" width="160" height="46" as="geometry"/></mxCell><mxCell id="66" value="System / automatic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="1824" width="160" height="46" as="geometry"/></mxCell><mxCell id="67" value="Order status value" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="840" y="1824" width="160" height="46" as="geometry"/></mxCell><mxCell id="68" value="Decision" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1914" width="150" height="64" as="geometry"/></mxCell><mxCell id="69" value="Start" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="240" y="1914" width="160" height="46" as="geometry"/></mxCell><mxCell id="70" value="End / outcome" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="1914" width="160" height="46" as="geometry"/></mxCell><mxCell id="71" value="Jump to another tab" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f0f0f0;strokeColor=#333333;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="1914" width="160" height="46" as="geometry"/></mxCell><mxCell id="72" value="Note" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f9f7ed;strokeColor=#36393d;align=left;spacingLeft=6;fontSize=11;fontSize=11;" vertex="1" parent="1"><mxGeometry x="840" y="1914" width="160" height="46" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="Order &amp; status lifecycle"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="11" value="Retailer wants garments" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="345" y="40" width="190" height="66" as="geometry"/></mxCell><mxCell id="12" value="Retailer opens Collections / Inventory / Sample Order,&lt;br&gt;adds items to Cart (or picks stock / fills sample form)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="300" y="156" width="280" height="72" as="geometry"/></mxCell><mxCell id="13" value="Retailer clicks 'Place Order'&lt;br&gt;(quantities validated, stock checked)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="315" y="278" width="250" height="66" as="geometry"/></mxCell><mxCell id="14" value="STATUS: PENDING&lt;br&gt;(Pending Orders page, yellow badge)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="325" y="394" width="230" height="56" as="geometry"/></mxCell><mxCell id="15" value="Admin opens Order Request → tab Fresh / Sample / Stock&lt;br&gt;(badge shows count of new requests)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="295" y="500" width="290" height="72" as="geometry"/></mxCell><mxCell id="16" value="Admin decision?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="340" y="622" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="Admin REJECTS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="487.5" y="800" width="200" height="66" as="geometry"/></mxCell><mxCell id="18" value="STATUS: REJECTED&lt;br&gt;(Rejected Orders page, red badge)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="472.5" y="930" width="230" height="56" as="geometry"/></mxCell><mxCell id="19" value="Admin ACCEPTS: fills PO no., prices, customization,&lt;br&gt;advance, shipping, invoice / estimate, uploads design,&lt;br&gt;sends manufacturer mail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="142.5" y="791" width="300" height="84" as="geometry"/></mxCell><mxCell id="20" value="System creates order + one barcode per piece&lt;br&gt;(stock orders: stock qty reduced)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="152.5" y="925" width="280" height="66" as="geometry"/></mxCell><mxCell id="21" value="STATUS: APPROVED / ACCEPTED&lt;br&gt;(My Orders → Accepted tab)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="177.5" y="1041" width="230" height="56" as="geometry"/></mxCell><mxCell id="22" value="How does retailer pay?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="192.5" y="1147" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="Retailer pays by card&lt;br&gt;(Stripe Checkout)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="330" y="1316" width="200" height="66" as="geometry"/></mxCell><mxCell id="24" value="Stripe webhook → payment saved,&lt;br&gt;payment_status = Paid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="310" y="1432" width="240" height="66" as="geometry"/></mxCell><mxCell id="25" value="Retailer pays by bank transfer&lt;br&gt;(bank details on Account page)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="1316" width="230" height="66" as="geometry"/></mxCell><mxCell id="26" value="Admin records / edits payment&lt;br&gt;(Order List → payment update)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="1432" width="230" height="66" as="geometry"/></mxCell><mxCell id="27" value="PAYMENT: Unpaid → Partial → Paid&lt;br&gt;(Dashboard shows bill / paid / balance)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="162.5" y="1548" width="260" height="56" as="geometry"/></mxCell><mxCell id="28" value="STAGE 1  PATTERN" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="197.5" y="1668" width="190" height="56" as="geometry"/></mxCell><mxCell id="29" value="STAGE 2  KHAKA" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="345" y="1822" width="190" height="56" as="geometry"/></mxCell><mxCell id="30" value="STAGE 3  ISSUE BEADING" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="345" y="1928" width="190" height="56" as="geometry"/></mxCell><mxCell id="31" value="STAGE 4  BEADING" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="345" y="2034" width="190" height="56" as="geometry"/></mxCell><mxCell id="32" value="STAGE 5  ZARKAN" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="345" y="2140" width="190" height="56" as="geometry"/></mxCell><mxCell id="33" value="STAGE 6  STITCHING" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="345" y="2246" width="190" height="56" as="geometry"/></mxCell><mxCell id="34" value="STAGE 7  REPAIR (if needed)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="345" y="2352" width="190" height="56" as="geometry"/></mxCell><mxCell id="35" value="STAGE 8  BALANCE PENDING" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="345" y="2458" width="190" height="56" as="geometry"/></mxCell><mxCell id="36" value="Production worker scans the piece barcode on&lt;br&gt;the scanner page; their login is tied to one stage&lt;br&gt;(duplicate scans are blocked)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="435" y="1654" width="290" height="84" as="geometry"/></mxCell><mxCell id="37" value="Balance paid in full?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="340" y="2564" width="200" height="100" as="geometry"/></mxCell><mxCell id="38" value="Retailer settles balance&lt;br&gt;(card / bank)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="413.9" y="2733" width="200" height="66" as="geometry"/></mxCell><mxCell id="39" value="Admin marks READY TO DELIVERY&lt;br&gt;(Global QR Scan / admin only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="320" y="2849" width="240" height="66" as="geometry"/></mxCell><mxCell id="40" value="STAGE 9  READY TO DELIVERY" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="330" y="2965" width="220" height="56" as="geometry"/></mxCell><mxCell id="41" value="Shipping worker does final scan&lt;br&gt;(confirm ship)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="340" y="3071" width="200" height="66" as="geometry"/></mxCell><mxCell id="42" value="STAGE 10  SHIPPED" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="345" y="3187" width="190" height="56" as="geometry"/></mxCell><mxCell id="43" value="Admin adds tracking ID /&lt;br&gt;shipping status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;spacing=4;" vertex="1" parent="1"><mxGeometry x="340" y="3293" width="200" height="66" as="geometry"/></mxCell><mxCell id="44" value="Retailer sees order in Delivered tab&lt;br&gt;with tracking ID" style="rounded=1;arcSize=50;wh